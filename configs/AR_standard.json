{
  "experiment_id": "AR_standard",
  "display_name": "AR / standard / final 2021",
  "structure": "AR",
  "channel": "171",
  "description": "Standard experiment for active region segmentation. The models were trained on the full available AR training dataset and evaluated on the final 2021 prediction dataset with threshold 0.25.",

  "training_config": {
    "training_enabled_in_repository": false,
    "training_data_in_repository": false,
    "train_dataset": "full AR training dataset",
    "annotation_sources": ["SPoCA", "Zooniverse"],
    "image_channel": "171 Å",
    "image_size": [256, 256],
    "sequence_length": 4,
    "previous_frames": 3,
    "time_offsets_minutes": [30, 20, 10],
    "target_frame_included": true,

    "baseline_model": {
      "name": "SCSS-Net",
      "input_type": "single target image",
      "input_shape": [256, 256, 1]
    },

    "convlstm_model": {
      "name": "ConvLSTM-SCSS-Net",
      "input_type": "temporal sequence",
      "input_shape": [4, 256, 256, 1]
    },

    "model_parameters": {
      "filters": 32,
      "encoder_decoder_levels": 4,
      "dropout": 0.3,
      "convlstm_filters": 32,
      "batch_size_baseline": 8,
      "batch_size_convlstm": 8
    },

    "training_parameters": {
      "loss": "BCE + Dice loss",
      "optimizer": "Adam",
      "metrics": ["Dice", "IoU"]
    },

    "preprocessing": {
      "remove_black_background": false,
      "grayscale": true,
      "resize": [256, 256],
      "normalize_0_1": true
    },

    "note": "The full temporal training dataset is not included in the repository because of its size. The notebook keeps the training pipeline structure, but loads the saved trained models for final prediction."
  },

  "prediction_config": {
    "prediction_dataset": "AR final 2021",
    "threshold": 0.25,

    "models": {
      "baseline": "trained_models/AR_standart_models/AR_base_model.keras",
      "convlstm": "trained_models/AR_standart_models/AR_ConvLstm_model.keras"
    },

    "archives": [
      "data/AR_predict_2021/images_AR.zip",
      "data/AR_predict_2021/masks_AR.zip",
      "data/AR_predict_2021/sequences_exp_AR.zip"
    ],

    "output_dir": "outputs/AR_standard",

    "postprocessing": {
      "probability_map": true,
      "binary_threshold": 0.25,
      "save_binary_masks": true,
      "create_overlay": true,
      "create_model_comparison": true
    }
  }
}
